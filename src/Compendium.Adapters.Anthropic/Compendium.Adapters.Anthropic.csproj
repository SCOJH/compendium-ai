<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Compendium.Adapters.Anthropic</AssemblyName>
    <RootNamespace>Compendium.Adapters.Anthropic</RootNamespace>
    <PackageId>Compendium.Adapters.Anthropic</PackageId>
    <Description>Anthropic AI provider adapter for the Compendium framework. Implements IAIProvider against the Anthropic Messages API (Claude 3.5 / 3.7 / 4.x family) with streaming SSE, error mapping, and optional prompt caching.</Description>
    <PackageTags>compendium;adapter;anthropic;claude;ai;llm</PackageTags>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compendium framework — consumed as published NuGets per ADR-0006. -->
    <PackageReference Include="Compendium.Core" />
    <PackageReference Include="Compendium.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" VersionOverride="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="System.Text.Json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Compendium.Adapters.Anthropic.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- In-repo abstraction (was a Compendium.Abstractions.AI PackageReference) -->
    <ProjectReference Include="..\Compendium.Abstractions.AI\Compendium.Abstractions.AI.csproj" />
  </ItemGroup>

</Project>
