<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Compendium.Adapters.Cohere</AssemblyName>
    <RootNamespace>Compendium.Adapters.Cohere</RootNamespace>
    <PackageId>Compendium.Adapters.Cohere</PackageId>
    <Description>Cohere adapter for Compendium. Implements IReranker over Cohere's Rerank API (POST /v2/rerank, the rerank-v5.0, rerank-v4.0 and rerank-v3.5 models): batched, bounded in flight, every document ranked exactly once, every failure a Result.</Description>
    <PackageTags>compendium;adapter;cohere;ai;rerank;reranker;rag</PackageTags>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compendium framework — consumed as published NuGets per ADR-0006. -->
    <PackageReference Include="Compendium.Core" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <!-- System.Text.Json comes from the shared framework on both targets (NU1510 on the .NET 10 SDK). -->
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Compendium.Adapters.Cohere.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Compendium.Abstractions.AI\Compendium.Abstractions.AI.csproj" />
  </ItemGroup>

</Project>
