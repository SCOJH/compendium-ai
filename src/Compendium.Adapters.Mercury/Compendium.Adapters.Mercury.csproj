<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Compendium.Adapters.Mercury</AssemblyName>
    <RootNamespace>Compendium.Adapters.Mercury</RootNamespace>
    <PackageId>Compendium.Adapters.Mercury</PackageId>
    <Description>Mercury AI provider adapter for Compendium Framework. Implements IAIProvider against Inception Labs' OpenAI-compatible diffusion LLM API (mercury, mercury-coder, mercury-edit). Exploratory / experimental — Mercury is an early-stage diffusion-based LLM platform.</Description>
    <PackageTags>compendium;adapter;mercury;inception-labs;ai;llm;diffusion</PackageTags>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compendium framework — consumed as published NuGets per ADR-0006. -->
    <PackageReference Include="Compendium.Core" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="System.Text.Json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Compendium.Adapters.Mercury.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- In-repo abstraction (was a Compendium.Abstractions.AI PackageReference) -->
    <ProjectReference Include="..\Compendium.Abstractions.AI\Compendium.Abstractions.AI.csproj" />
  </ItemGroup>

</Project>
